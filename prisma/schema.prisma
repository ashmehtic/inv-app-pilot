generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Admin Module ─────────────────────────────────────────────────────────

model AdminAppUsersRegistry {
  id                String    @id @default(cuid())
  email             String    @unique
  firstName         String
  lastName          String
  isActive          Boolean   @default(false)
  activeEndDate     DateTime?
  password          String
  mustResetPassword Boolean   @default(true)
  emailVerified     DateTime?
  createdAt         DateTime  @default(now())

  userRoles         UserRole[]
}

model Role {
  id   String @id @default(cuid())
  name String @unique  // INV_APP_USER, ADMIN_USER

  userRoles UserRole[]
}

model UserRole {
  userId String
  roleId String

  user AdminAppUsersRegistry @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role                  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ─── Admin Modules ─────────────────────────────────────────────────────────

model ProductCategory {
  prodCategoryId String @id
  prodCategory   String @db.VarChar(25)
  activeYN       String @default("Y") @db.Char(1)

  products Product[]
}

model Product {
  productId       String @id
  prodCategoryId  String
  productName     String @db.VarChar(100)
  productType     String @db.VarChar(20)
  defaultQuantity Int
  productUnit     String @db.VarChar(20)
  trackProductYN  String @default("N") @db.Char(1)
  activeYN        String @default("Y") @db.Char(1)

  productCategory ProductCategory @relation(fields: [prodCategoryId], references: [prodCategoryId])
  templateDetails ProgramTemplatesDetails[]
}

model Site {
  siteId      String @id
  siteName    String @db.VarChar(50)
  siteAddress String @db.VarChar(255)
  activeYN    String @default("Y") @db.Char(1)
}

model ProgramTemplatesMaster {
  progTemplateId   String @id
  progTemplateName String @db.VarChar(100)
  progNotes        String @db.VarChar(200)
  activeYN         String @default("Y") @db.Char(1)

  details ProgramTemplatesDetails[]
}

model ProgramTemplatesDetails {
  progTemplateId String
  productId      String
  quantity       Int
  productUnit    String @db.VarChar(20)
  trackProductYN String @db.Char(1)

  programTemplate ProgramTemplatesMaster @relation(fields: [progTemplateId], references: [progTemplateId])
  product         Product                @relation(fields: [productId], references: [productId])

  @@id([progTemplateId, productId])
}
