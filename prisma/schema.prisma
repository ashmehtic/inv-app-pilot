generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── NextAuth Required Tables ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?

  sessions      Session[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Admin Module ─────────────────────────────────────────────────────────

model AdminAppUsersRegistry {
  id            String    @id @default(cuid())
  email         String    @unique
  firstName     String
  lastName      String
  isActive      Boolean   @default(false)
  activeEndDate DateTime?
  createdAt     DateTime  @default(now())
}

model Role {
  id   String @id @default(cuid())
  name String @unique  // INV_APP_USER, ADMIN_USER

  userRoles UserRole[]
}

model UserRole {
  userId String
  roleId String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

