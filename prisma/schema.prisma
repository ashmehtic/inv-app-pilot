generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Admin Module ─────────────────────────────────────────────────────────

model AdminAppUsersRegistry {
  id                String    @id @default(cuid())
  email             String    @unique
  firstName         String
  lastName          String
  isActive          Boolean   @default(false)
  activeEndDate     DateTime?
  password          String
  mustResetPassword Boolean   @default(true)
  emailVerified     DateTime?
  createdAt         DateTime  @default(now())

  userRoles         UserRole[]
}

model Role {
  id   String @id @default(cuid())
  name String @unique  // INV_APP_USER, ADMIN_USER

  userRoles UserRole[]
}

model UserRole {
  userId String
  roleId String

  user AdminAppUsersRegistry @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role                  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}
